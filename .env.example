# Airtable Configuration
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_API_KEY=keyXXXXXXXXXXXXXX

# YooKassa Credentials (если Banks.CredentialsSource = "ENV")
# Для каждого Banks record с ENVPrefix создайте пару переменных:
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_abcd...

# Для тестового аккаунта (ENVPrefix = "YOOKASSA_TEST")
YOOKASSA_TEST_SHOP_ID=654321
YOOKASSA_TEST_SECRET_KEY=test_xyz...

# Payment Return URL
PAYMENT_RETURN_URL=https://orders.baza.menu/payment/result

# Секрет для GET /api/payment_reconcile (cron). Дублировать как RECONCILE_SECRET не обязательно — запасное имя, если в Vercel конфликт имён.
PAYMENT_RECONCILE_KEY=
# RECONCILE_SECRET=

# Обратная связь по обедам (таблица MealFeedback — см. MEAL_FEEDBACK_AIRTABLE.md)
# TBL_MEAL_FEEDBACK=MealFeedback
# FLD_FB_EMPLOYEE=Employee
# FLD_FB_ORG=Organization
# FLD_FB_MEAL_DATE=MealDate
# FLD_FB_RATING=Rating
# FLD_FB_COMMENT=Comment

# Debug
DEBUG_ROUTES=off
