# Airtable Configuration
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_API_KEY=keyXXXXXXXXXXXXXX

# YooKassa Credentials (если Banks.CredentialsSource = "ENV")
# Для каждого Banks record с ENVPrefix создайте пару переменных:
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_abcd...

# Для тестового аккаунта (ENVPrefix = "YOOKASSA_TEST")
YOOKASSA_TEST_SHOP_ID=654321
YOOKASSA_TEST_SECRET_KEY=test_xyz...

# Payment Return URL
PAYMENT_RETURN_URL=https://orders.baza.menu/payment/result

# Debug
DEBUG_ROUTES=off
